# Copy this file to .env and fill in real values. NEVER commit .env.
NODE_ENV=development
PORT=5000

# MongoDB Atlas connection string (Atlas > Connect > Drivers)
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/resolvex?retryWrites=true&w=majority

# Frontend origin allowed by CORS
CLIENT_URL=http://localhost:5173

# Generate each with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Optional: Cloudinary (free tier) for complaint attachments. Without these, uploads return 503.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# SLA escalation job (runs inside the API process every minute). Set to false to disable.
ENABLE_SLA_JOB=true
# Minutes before a resolution deadline at which a one-time SLA warning is sent.
SLA_WARNING_MINUTES=60
